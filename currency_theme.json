{
  "name": "Currency Dashboard Soft Light",
  "dataColors": [
    "#60A5FA",
    "#34D399",
    "#F87171",
    "#FBBF24",
    "#A78BFA",
    "#F472B6",
    "#2DD4BF",
    "#FB923C",
    "#818CF8",
    "#A3E635"
  ],
  "tableAccent": "#60A5FA",
  "good": "#34D399",
  "neutral": "#94A3B8",
  "bad": "#F87171",
  "maximum": "#60A5FA",
  "center": "#CBD5E1",
  "minimum": "#F1F5F9",
  "null": "#CBD5E1",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#EDF0F4"
              }
            },
            "radius": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": { "color": "#1F2937" }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": { "color": "#475569" }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": { "color": "#7B8595" }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": { "color": "#7B8595" }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": { "color": "#475569" }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": { "color": "#1F2937" }
            },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 32
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": { "color": "#7B8595" }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FAFBFC"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}